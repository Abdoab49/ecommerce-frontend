// ============================================
// LANGUAGE SETTINGS
// ============================================

const supportedLanguages = ['en', 'fr', 'ar'];

const savedLanguage =
  localStorage.getItem('lanada_language') || 'en';

const initialLanguage = savedLanguage
  .split('-')[0]
  .toLowerCase();

// ============================================
// INITIALIZE I18NEXT
// ============================================

i18n
  .use(initReactI18next)
  .init({
    resources,

    lng: supportedLanguages.includes(initialLanguage)
      ? initialLanguage
      : 'en',

    fallbackLng: 'en',

    supportedLngs: supportedLanguages,

    interpolation: {
      escapeValue: false,
    },

    react: {
      useSuspense: false,
    },
  });

// ============================================
// RTL / LTR + SAVE LANGUAGE
// ============================================

const updateDocumentLanguage = (language) => {
  const lang = String(language || 'en')
    .split('-')[0]
    .toLowerCase();

  const validLanguage = supportedLanguages.includes(lang)
    ? lang
    : 'en';

  const isArabic = validLanguage === 'ar';

  document.documentElement.lang = validLanguage;
  document.documentElement.dir = isArabic ? 'rtl' : 'ltr';

  document.body.dir = isArabic ? 'rtl' : 'ltr';

  localStorage.setItem(
    'lanada_language',
    validLanguage
  );
};

// Apply initial language
updateDocumentLanguage(initialLanguage);

// Update whenever the visitor changes language
i18n.on('languageChanged', updateDocumentLanguage);

export default i18n;
